    "tailwindcss": "^3.4.17", "autoprefixer": "^10.4.20", "postcss": "^8.4.49",
    "jest": "^29.7.0", "jest-environment-jsdom": "^29.7.0", "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3", "@playwright/test": "^1.49.1", "tsx": "^4.19.2",
    "eslint": "^9.17.0", "eslint-config-next": "^15.1.0"
  }
