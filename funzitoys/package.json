    "db:generate": "npx prisma generate", "db:push": "npx prisma db push", "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy", "db:seed": "npx tsx prisma/seed.ts", "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset --force && npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "next": "^15.1.0", "react": "^19.0.0", "react-dom": "^19.0.0", "typescript": "^5.7.2",
