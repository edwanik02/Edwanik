    "zod": "^3.23.8", "zustand": "^5.0.2", "@tanstack/react-query": "^5.62.7", "framer-motion": "^11.15.0",
    "cloudinary": "^2.5.1", "nodemailer": "^6.9.16", "react-dropzone": "^14.3.5", "lucide-react": "^0.468.0",
    "@upstash/ratelimit": "^2.0.4", "@upstash/redis": "^1.34.3", "tailwind-merge": "^2.5.5", "clsx": "^2.1.1",
    "recharts": "^2.14.1", "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2", "@types/react": "^19.0.2", "@types/react-dom": "^19.0.2",
